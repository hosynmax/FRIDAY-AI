PORT=8080
# Internal Docker network address. Never expose Ollama directly to the public internet.
OLLAMA_BASE_URL=http://ollama:11434
# Qwen2.5 3B is a relatively lightweight multilingual model; change to qwen2.5:7b for better quality if hardware permits.
OLLAMA_MODEL=qwen2.5:3b
MODEL_TIMEOUT_MS=120000
RATE_LIMIT_PER_MINUTE=20
CORS_ORIGIN=
FRIDAY_SYSTEM_PROMPT=You are FRIDAY, a helpful, careful multilingual assistant. Reply in the user's language, including Persian when the user writes Persian. Be honest about uncertainty.
